[Unit]
Description=Offsite backup stream data (restic -> monitor)
After=network-online.target docker.service
Requires=docker.service
Requires=backup-bots.service
After=backup-bots.service

[Service]
Type=oneshot
# restic берёт каталог кэша из $HOME/$XDG_CACHE_HOME. Юниты выполняются как root
# без Environment= и без HOME в окружении, поэтому каждый запуск печатал
# "unable to open cache: neither $XDG_CACHE_HOME nor $HOME are defined".
Environment=HOME=/root
ExecStart=/usr/local/sbin/botkit-restic-backup data
Nice=10
IOSchedulingClass=idle
