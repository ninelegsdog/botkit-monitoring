# Параметры offsite-бэкапа restic. Это ШАБЛОН: секретов здесь нет и быть не должно.
# Реальные значения живут только на проде в /root/.botkit-backup/*.pw (600).

# Хост-приёмник репозиториев (монитор)
BACKUP_HOST=31.76.11.198
# Пользователь SFTP с chroot-изоляцией
BACKUP_USER=botkit-backup

# Репозитории (по одному паролю на репозиторий, пароли НЕ совпадают)
REPO_DATA=sftp:botkit-backup@31.76.11.198:/repo-data
REPO_MONITOR=sftp:botkit-backup@31.76.11.198:/repo-monitor

# Файлы паролей: root-только, 600
PW_DIR=/root/.botkit-backup
# Ключ SFTP: ed25519, без passphrase, доступ только для botkit-backup
KEY=/root/.ssh/id_ed25519_botkit_backup

# Пороги проверки свежести, секунды (снапшот каждые 6 ч)
MAXAGE_DATA=28800
MAXAGE_MONITOR=36000
# Alertmanager для немедленного уведомления при сбое
ALERTMANAGER_URL=http://127.0.0.1:9093

# Bootstrap репозиториев (выполняется один раз, вручную):
#   install -d -m 700 /root/.botkit-backup
#   openssl rand -base64 32 | tr -d '\n' > /root/.botkit-backup/data.pw && chmod 600 /root/.botkit-backup/data.pw
#   openssl rand -base64 32 | tr -d '\n' > /root/.botkit-backup/monitor.pw && chmod 600 /root/.botkit-backup/monitor.pw
#   RESTIC_PASSWORD_FILE=/root/.botkit-backup/data.pw    restic -r sftp:botkit-backup@31.76.11.198:/repo-data init
#   RESTIC_PASSWORD_FILE=/root/.botkit-backup/monitor.pw restic -r sftp:botkit-backup@31.76.11.198:/repo-monitor init
# ПАРОЛИ СРАЗУ СКОПИРОВАТЬ В МЕНЕДЖЕР ПАРОЛЕЙ: второй экземпляр восстановления невозможен.
