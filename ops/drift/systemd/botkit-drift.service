[Unit]
Description=Botkit config drift check (canon vs prod)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Run the script out of the synced repository. The copy this unit used to point at lived in
# /opt/botkit-drift and was installed by hand: it had fallen behind canon, so the check that
# reports drift had itself drifted, and nothing here could notice. sync-canon.sh now also
# asserts that every ops script parses, so a broken canon commit fails the sync instead of
# quietly unmonitoring the fleet.
#
# bash is named explicitly because the repository file is not marked executable, and
# check_drift.sh sources ../lib/fleet.sh relative to its own location - which only resolves
# from inside the repository.
ExecStart=/usr/bin/bash /home/deploy/botkit-monitoring/ops/drift/check_drift.sh
TimeoutStartSec=300
# The unit used to run as bare root with no isolation at all. The script is read-only apart
# from its own state and log, so the filesystem is pinned: the deployment tree and the
# monitoring checkout stay readable and nothing else is writable. ProtectHome is left off
# deliberately - the check has to read /home/deploy/botkit-*/.git to compare HEAD against
# origin/main, and ReadWritePaths cannot re-open a path that ProtectHome closed.
#
# Running as root is not changed: the check reads container state through the docker CLI, and
# membership of the docker group is root-equivalent, so a dedicated user would be theatre.
# What this buys is that a compromised script cannot write outside three directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
# ProtectSystem=strict closes the whole filesystem except ReadWritePaths, and that includes
# /home/deploy - where the check runs `git fetch` to compare HEAD against origin/main. The
# first version of this isolation listed /home/deploy as read-only and every bot went to
# "WATCH hold: git fetch failed", which is a false signal, not a real drift.
#
# Only .git directories are opened, and only because git writes FETCH_HEAD, refs and
# objects there; the checked-out working trees stay read-only. Listing the nine explicitly
# beats listing /home/deploy, which would hand the check write access to the code it audits.
# The '-' prefix skips a path that does not exist: systemd otherwise refuses to start the
# unit at all, so one renamed bot would turn the drift check off entirely rather than
# report one unreadable clone. Same lesson as InaccessiblePaths in botkit-e2e.service.
ReadWritePaths=/var/backups/botkit-drift /var/log
ReadWritePaths=-/home/deploy/botkit-bookingbot/.git
ReadWritePaths=-/home/deploy/botkit-leadgen/.git
ReadWritePaths=-/home/deploy/botkit-store/.git
ReadWritePaths=-/home/deploy/botkit-support/.git
ReadWritePaths=-/home/deploy/botkit-membership/.git
ReadWritePaths=-/home/deploy/botkit-pricesentry/.git
ReadWritePaths=-/home/deploy/botkit-docuflow/.git
ReadWritePaths=-/home/deploy/botkit-delivery/.git
ReadWritePaths=-/home/deploy/botkit-reminder/.git
