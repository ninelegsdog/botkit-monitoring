# Copy to /etc/botkit-e2e/e2e.env on the E2E host and fill in. Never commit it.
#
# TG_PHONE is deliberately absent. The session is signed in once on an admin
# machine (first_login.py) and the resulting .session file is copied over;
# keeping a phone number on the E2E host would put a second-factor credential
# next to an account that already has full access to the nine bots.
TG_API_ID=
TG_API_HASH=

# 30s per step: long enough for a slow bot, short enough that a dead bot fails
# inside one timer slot.
E2E_TIMEOUT=30

# Where the runner reads bot usernames. The file holds usernames only - the
# runner cannot read a bot token, and tests/test_no_token_reads.py is the gate.
E2E_BOTS_FILE=/etc/botkit-e2e/bots.yml

# Session lives outside $HOME on purpose (plan §E2 condition 1).
E2E_SESSION_DIR=/var/lib/botkit-e2e/session
E2E_SESSION_NAME=botkit-e2e
E2E_STATUS_DIR=/var/lib/botkit-e2e/status

# Required. Without it a failure cannot be alerted on, and the runner says so
# loudly instead of exiting 0 as if the alert had gone out.
# On the E2E host this goes through the dedicated e2e-am-tunnel (19093 -> prod
# 127.0.0.1:9093); direct 127.0.0.1:9093 only works from the prod host itself.
E2E_ALERT_URL=http://127.0.0.1:19093/api/v2/alerts
