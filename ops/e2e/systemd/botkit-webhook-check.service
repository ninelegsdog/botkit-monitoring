[Unit]
Description=Botkit Telegram webhook delivery check (getWebhookInfo contract)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/root/botkit-webhook-check/webhook_check.sh
TimeoutStartSec=180
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/log /var/lib/botkit-webhook-check /var/backups/botkit-webhook-check
