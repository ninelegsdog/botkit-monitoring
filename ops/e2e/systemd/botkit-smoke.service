[Unit]
Description=Botkit smoke test (webhook auth + health + logs)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The synced canon, not the copy under /root/botkit-e2e. That copy still carried
# `curl -k`, so the scheduled run kept reporting "external TLS ok" for a certificate
# no third party accepts — the check everyone trusted was the one not in effect.
# botkit-sync-canon keeps this path current; a copy cannot keep itself current.
ExecStart=/home/deploy/botkit-monitoring/ops/e2e/smoke_all.sh
TimeoutStartSec=180
