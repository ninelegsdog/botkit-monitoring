# fleet.env — ЕДИНЫЙ источник истины по флоту ботов.
#
# Sourced операционными скриптами (smoke_all.sh, check_drift.sh, webhook_check.sh).
# Формат: "<bot>:<metrics_port>". Порядок = порядок вывода в отчётах.
#
# Контракт внешнего endpoint (менять только вместе с проверкой webhook_check.sh):
#   WEBHOOK_DOMAIN — публичный домен, на который зарегистрированы webhooks в Telegram
#   WEBHOOK_IP     — статический IPv4 duckdns (совпадает с ip_address в setWebhook)
#
# ВАЖНО: Telegram сверяет сертификат сервера по схеме, заданной при setWebhook.
# Пока сертификат публичный (Let's Encrypt), поле `certificate` передаваться НЕ должно:
# иначе has_custom_certificate=true и доставка ломается с "certificate verify failed".
FLEET="bookingbot:8081 leadgen:8082 store:8083 support:8084 membership:8085 pricesentry:8086 docuflow:8087 delivery:8088 reminder:8089"
WEBHOOK_DOMAIN="ninelegsbots.duckdns.org"
WEBHOOK_IP="2.27.204.95"
