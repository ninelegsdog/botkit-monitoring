# fleet.env — ЕДИНЫЙ источник истины по флоту ботов и по адресам мониторинга.
#
# Sourced операционными скриптами. Shell-скрипты берут его через
# ops/lib/fleet.sh, Python - через парсер в webhook_check.py.
#
# Формат FLEET: "<bot>:<metrics_port>". Порядок = порядок вывода в отчётах.
#
# ВНИМАНИЕ к Alertmanager и Prometheus: 127.0.0.1, НЕ localhost. На этой машине
# localhost резолвится и в ::1, где никто не слушает, и curl молча уходит в
# никуда. До S1 в check_backups.sh стоял именно localhost.
#
# Контракт внешнего endpoint (менять только вместе с проверкой webhook_check.sh):
#   WEBHOOK_DOMAIN — публичный домен, на который зарегистрированы webhooks в Telegram
#   WEBHOOK_IP     — статический IPv4 duckdns (совпадает с ip_address в setWebhook)
#
# ВАЖНО: Telegram сверяет сертификат сервера по схеме, заданной при setWebhook.
# Пока сертификат публичный (Let's Encrypt), поле `certificate` передаваться НЕ должно:
# иначе has_custom_certificate=true и доставка ломается с "certificate verify failed".
FLEET="bookingbot:8081 leadgen:8082 store:8083 support:8084 membership:8085 pricesentry:8086 docuflow:8087 delivery:8088 reminder:8089"

WEBHOOK_DOMAIN="ninelegsbots.duckdns.org"
WEBHOOK_IP="2.27.204.95"

# --- канал раскатки образов (03.10) --------------------------------------------
# Канонический образ бота: <CHANNEL>-<sha7>, где sha7 — последний успешный
# прогон deploy.yml. Это значение жило в /opt/botkit-rollout/version.conf, то
# есть вне git; check_drift.sh и check_updates.sh читали его оттуда, и
# contract-тест об этом коде не знал. Теперь источник один.
CHANNEL="v0.8.2"

# --- карта портов мониторинга (S1) ---------------------------------------------
# Единственное место, где названы эти адреса. Контракт-тест
# ops/e2e/tests/test_fleet_contract.py падает при удалении любой строки отсюда
# и при появлении жёстко зашитого порта в операционном скрипте.
BASE_URL="http://127.0.0.1"
PROMETHEUS_URL="http://127.0.0.1:9090"
ALERTMANAGER_URL="http://127.0.0.1:9093"
ALERTMANAGER_ALERTS_URL="http://127.0.0.1:9093/api/v2/alerts"
# Query form used by e2e-alerting.sh to wait for an alert to appear and clear.
ALERTMANAGER_ALERTS_ACTIVE_URL="http://127.0.0.1:9093/api/v2/alerts?active=true"
GRAFANA_URL="http://127.0.0.1:3000"
LOKI_URL="http://127.0.0.1:3100"
TEMPO_URL="http://127.0.0.1:3200"
MINIO_URL="http://127.0.0.1:9000"
MINIO_CONSOLE_URL="http://127.0.0.1:9001"
OTLP_HTTP_URL="http://127.0.0.1:4318/v1/traces"
OTLP_GRPC_URL="http://127.0.0.1:4317"

# --- сеть наблюдения (S1, подготовка S3) --------------------------------------
# amnezia-awg2 не трогаем. Это отдельная будущая сеть между продом и монитором.
WG_OBSERVE_SUBNET="10.77.0.0/24"
WG_OBSERVE_PROD_IP="10.77.0.1"
WG_OBSERVE_MONITOR_IP="10.77.0.2"
WG_OBSERVE_PORT="51820"
